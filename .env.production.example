# Common
SITE_URL=https://streamflowagency.com
APP_TIMEZONE=UTC+6
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<db>?sslmode=no-verify
DB_CONNECT_TIMEOUT=15

# Telegram
BOT_TOKEN=<telegram_bot_token>
ADMIN_GROUP_ID=<-100xxxxxxxxxx>
ADMIN_USERNAME=<admin_username_without_@>
BOT_USERNAME=<bot_username_without_@>
CHANNEL_ID=<-100xxxxxxxxxx>
CHANNEL_EN_ID=<-100xxxxxxxxxx>
CHANNEL_PT_ID=<-100xxxxxxxxxx>
CHANNEL_ES_ID=<-100xxxxxxxxxx>
CHANNEL_LINK=https://t.me/streamflowagency
PROJECT_KEY=streamflow_agency

# Optional second project (Starflow)
STARFLOW_BOT_TOKEN=<starflow_bot_token>
STARFLOW_BOT_USERNAME=<starflow_bot_username_without_@>
STARFLOW_BOT_LINK=https://t.me/<starflow_bot_username>
STARFLOW_CHANNEL_LINK=https://t.me/starflowcorp
STARFLOW_SITE_URL=https://streamflowagency.com/starflow.html
STARFLOW_ADMIN_GROUP_ID=<-100xxxxxxxxxx>
STARFLOW_PUBLIC_MANAGER_HANDLE=@starflowmanager
STARFLOW_ENABLE_ADMIN_JOBS=false
OPENAI_API_KEY=<openai_api_key>
OPENAI_TRANSLATE_MODEL=gpt-4o-mini
OPENAI_HTTP_TIMEOUT_SECONDS=30

# Web service
HOST=0.0.0.0
WEB_SEND_FULL_TO_ADMIN=false
INFOBIP_BOT_ENABLED=true
INFOBIP_INTERACTIVE_ENABLED=true
INFOBIP_FORWARD_TO_ADMIN=false
INFOBIP_RELAY_MODE=false
INFOBIP_API_KEY=<infobip_api_key>
INFOBIP_BASE_URL=https://<your-base-url>.api.infobip.com
INFOBIP_WHATSAPP_SENDER=<sender_number_or_id>
